{
  // Picofolio — Cloudflare Worker that serves the built SPA (static assets)
  // and proxies the app's /api/* calls to Yahoo / MarketData / IBKR Flex.
  // Deploy: `pnpm deploy`. Local prod-parity: `pnpm preview:cf`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "picofolio",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    // Built SPA output. `single-page-application` serves index.html for any
    // unmatched path so react-router BrowserRouter deep links resolve.
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Navigations reach the Worker so app routes can get the plain shell
    // (app.html) while "/" serves the prerendered landing page. Hashed
    // bundles skip the Worker entirely.
    "run_worker_first": ["/*", "!/assets/*"],
  },
  // Invocation logs record full request URLs. No token travels in a URL any
  // more (see worker/index.ts), but keep request-level logging off anyway —
  // this app proxies users' broker traffic and has no business retaining it.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
  },
}
