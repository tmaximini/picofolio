{
  "name": "picofolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A minimal, local-first desktop portfolio tracker and trading journal for Interactive Brokers — keyboard-first, BYOK, obsessively designed.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/picofolio/picofolio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/picofolio/picofolio.git"
  },
  "bugs": {
    "url": "https://github.com/picofolio/picofolio/issues"
  },
  "keywords": [
    "portfolio-tracker",
    "trading-journal",
    "interactive-brokers",
    "ibkr",
    "options",
    "local-first",
    "tauri"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "preview:cf": "pnpm build && wrangler dev",
    "deploy:cf": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "html-to-image": "^1.11.13",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.16.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.10.6",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.103.0"
  }
}
